# Supabase backend — values from your supabase project:
# Dashboard -> Project Settings -> Data API (URL) and API Keys (anon / publishable key).
# Set the same two variables in Vercel -> Project -> Settings -> Environment Variables.
OCULAR_SUPABASE_URL=
OCULAR_SUPABASE_ANON_KEY=

# If set to true it will be possible to use the app without authentication
OCULAR_HYBRID_MODE=

# Optional, pre-filled login credentials for local testing
OCULAR_TEST_USERNAME=
OCULAR_TEST_PASSWORD=
