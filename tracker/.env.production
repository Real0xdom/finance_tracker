# Supabase client config, baked into the production build.
#
# The anon key is Supabase's *publishable* client key. Every table it can reach
# is guarded by row level security, so it grants nothing without a login --
# verified: unauthenticated reads return [] and writes fail with 42501 on all
# four ft_* tables and on the legacy user_data table.
#
# Committing it here removes the CI secrets plumbing as a failure point.
# Repository secrets or variables of the same names still take precedence.
FT_SUPABASE_URL=https://vxubkbxehsxjanhljhue.supabase.co
FT_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ4dWJrYnhlaHN4amFuaGxqaHVlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ0NjI1NTAsImV4cCI6MjEwMDAzODU1MH0.PX9YM4NXdJjWWQtPoRBvkkoI5i5jBTgyh4gGcPsInxo
